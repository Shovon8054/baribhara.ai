PORT=8081
HOST=0.0.0.0

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Option A (recommended for Render + Supabase): set individual vars below.
# Option B: set DATABASE_URL to a full connection string instead.
#
# Supabase pooler (port 6543 = transaction pooler, port 5432 = session pooler):
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=6543
#   DB_USER=postgres.<project-ref>
#   DB_PASSWORD=<your-supabase-db-password>
#   DB_NAME=postgres
#
# Local development (plain PostgreSQL, no SSL):
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_USER=postgres
#   DB_PASSWORD=your_local_password
#   DB_NAME=bashabhara
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=bashabhara

# Full connection string (overrides DB_* vars above if set).
# Use this if you prefer a single env var over individual parts.
# Do NOT embed ?sslmode= in this URL — SSL is controlled by the app's ssl option.
# DATABASE_URL=postgresql://user:password@host:port/database

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_RANDOM_SECRET

# ── Email (Gmail App Password) ────────────────────────────────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
VITE_API_URL=https://your-backend.onrender.com/api

# ── AI (optional) ─────────────────────────────────────────────────────────────
# App works without this using a local fallback.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
